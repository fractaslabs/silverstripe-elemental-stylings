<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Elemental Stylings">
    <description>Silverstripe module coding standards.</description>

    <file>src</file>
    <file>tests</file>

    <arg name="colors" />
    <arg value="sp" />

    <rule ref="PSR12">
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps" />
    </rule>
</ruleset>
