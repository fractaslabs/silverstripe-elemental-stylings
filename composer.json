{
    "name": "fractas/elemental-stylings",
    "type": "silverstripe-vendormodule",
    "description": "Collection of useful and reusable SilverStripe Elemental stylings properties",
    "homepage": "https://github.com/fractaslabs/silverstripe-elemental-stylings",
    "keywords": [
        "silverstripe",
        "content management",
        "styling",
        "elemental",
        "silverstripe elemental",
        "content blocks"
    ],
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/fractaslabs/silverstripe-elemental-stylings/issues"
    },
    "authors": [
        {
            "name": "Milan Jelicanin",
            "email": "milan.jelicanin@fractas.com"
        },
        {
            "name": "Petar Simic",
            "email": "petar.simic@fractas.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "dnadesign/silverstripe-elemental": "^6",
        "silverstripe/framework": "^6.2",
        "silverstripe/vendor-plugin": "^3"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.3",
        "silverstripe/frameworktest": "^2",
        "silverstripe/recipe-testing": "^4",
        "silverstripe/standards": "^1",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "autoload": {
        "psr-4": {
            "Fractas\\ElementalStylings\\": "src/",
            "Fractas\\ElementalStylings\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "lint": "phpcs",
        "test": "phpunit"
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
